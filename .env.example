# -----------------------------------------------------------------------------
# AccessPath AI — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local

# PostgreSQL (local docker-compose default below)
DATABASE_URL=postgresql://accesspath:accesspath@localhost:5433/accesspath

# Google Cloud / Vertex AI (Gemini)
# Use the competition Google Cloud project. Auth is via ADC locally;
# Cloud Run uses a dedicated service account — do not put keys here.
GOOGLE_CLOUD_PROJECT=your-competition-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini model id on Vertex AI (override only if the competition requires it)
VERTEX_AI_MODEL=gemini-2.0-flash-001

# Demo / safety
# Must stay true for hackathon demos (fictional seed data only)
USE_FICTIONAL_DEMO_DATA=true

# Optional: demo partner login token for Phase 3 (not a real auth system)
# DEMO_PARTNER_ACCESS_TOKEN=
