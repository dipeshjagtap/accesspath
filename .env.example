# -----------------------------------------------------------------------------
# AccessPath AI — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local

# PostgreSQL
# Docker compose default:
# DATABASE_URL=postgresql://accesspath:accesspath@localhost:5433/accesspath
# Local embedded Postgres (npm run db:up) when Docker is unavailable:
DATABASE_URL=postgresql://accesspath@127.0.0.1:5433/postgres

# Google Cloud / Vertex AI (Gemini) — preferred for competition
# Auth via ADC locally; Cloud Run dedicated SA. Do not commit keys.
GOOGLE_CLOUD_PROJECT=your-competition-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash-lite

# Optional local fallback (Gemini API / AI Studio) — SERVER ONLY
# Prefer Vertex+ADC for Cloud Run. Never expose to the browser or commit.
# GEMINI_API_KEY=

# Demo / safety
# Must stay true for hackathon demos (fictional seed data only)
USE_FICTIONAL_DEMO_DATA=true

# Legacy optional partner token (prefer real org login at /login)
# DEMO_PARTNER_ACCESS_TOKEN=
