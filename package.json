{
  "name": "accesspath-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/start-local-pg.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:ensure": "tsx --env-file=.env.local scripts/ensure-schema.ts",
    "user:set-role": "tsx --env-file=.env.local scripts/set-platform-role.ts",
    "db:up": "bash scripts/start-local-pg.sh",
    "demo:reset": "npm run db:push && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:phase1": "tsx --env-file=.env.local scripts/smoke-phase1.ts",
    "smoke:phase3": "tsx --env-file=.env.local scripts/smoke-phase3.ts",
    "test:ai-safety": "tsx --env-file=.env.local scripts/safety-ai-tests.ts",
    "verify:journey": "tsx --env-file=.env.local scripts/verify-demo-journey.ts",
    "verify:links": "tsx --env-file=.env.local scripts/verify-source-links.ts",
    "check:deploy-env": "tsx --env-file=.env.local scripts/check-deploy-env.ts",
    "verify:all": "npm run typecheck && npm run lint && npm run test && npm run test:ai-safety && npm run verify:journey && npm run verify:links && npm run check:deploy-env && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "^0.548.0",
    "next": "16.4.1",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.30",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
